{
  "name": "verisign",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:worker": "node scripts/build.mjs --worker",
    "dev": "wrangler dev",
    "dev:web": "pnpm --dir web dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply verisign --local",
    "db:migrate:remote": "wrangler d1 migrations apply verisign --remote",
    "test": "go test ./... && pnpm --dir web test"
  },
  "devDependencies": {
    "wrangler": "^4.151.0"
  }
}
